{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && npm install",
      "buildCommand": "cd ../.. && npm run build -w @local-mcp/shared && npm run build -w @local-mcp/web",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/((?!assets/).*)",
          "destination": "/index.html"
        }
      ]
    },
    "server": {
      "root": "apps/server",
      "framework": "fastify",
      "entrypoint": "dist/vercel.js",
      "installCommand": "cd ../.. && npm install",
      "buildCommand": "cd ../.. && npm run build -w @local-mcp/shared && npm run build -w @local-mcp/server",
      "functions": {
        "dist/vercel.js": {
          "maxDuration": 60,
          "memory": 1024
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/mcp",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/mcp/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}

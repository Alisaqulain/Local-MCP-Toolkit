# Local MCP Toolkit — safe defaults (no secrets)
HOST=127.0.0.1
PORT=3847

# Dev-only Vite origin (proxies /api and /mcp to PORT)
WEB_ORIGIN=http://127.0.0.1:5173

# Production single-origin public URL (optional; also added to CORS allowlist)
# PUBLIC_ORIGIN=https://toolkit.example.com

# Absolute or relative path to the sandboxed workspace
WORKSPACE_PATH=./data/workspace

# SQLite database (application data only — requires durable disk)
DATABASE_PATH=./data/db/toolkit.sqlite

# Vite production build directory (served by Fastify when SERVE_WEB=true)
WEB_DIST_PATH=./apps/web/dist

# Logging
LOG_LEVEL=info

# Limits
MAX_FILE_READ_BYTES=1048576
MAX_SEARCH_RESULTS=100
MAX_QUERY_ROWS=500
REQUEST_BODY_LIMIT=1048576

# Session token for dashboard API (generated on first start if empty)
# SESSION_TOKEN=

# Optional local AI (Ollama) — leave disabled by default
LOCAL_AI_ENABLED=false
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=

# CORS allowlist (comma-separated). Single-origin production adds http://HOST:PORT automatically.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3847,http://localhost:3847

# Remote binding (off by default — keep loopback for local toolkit)
ALLOW_NON_LOOPBACK=false
# ALLOWED_HOSTS=toolkit.example.com

# Serve Vite build from Fastify (npm start sets this true; also true when NODE_ENV=production)
# SERVE_WEB=true
